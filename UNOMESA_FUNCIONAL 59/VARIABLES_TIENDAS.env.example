# SERVIDOR VERCEL ÚNICAMENTE. Conservar todas las variables existentes.
# No usar prefijo NEXT_PUBLIC. No subir secretos a repositorios ni a apps.
APPLE_BILLING_ENABLED=false
APPLE_BILLING_MODE=test
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_ID=
GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_BILLING_MODE=test
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUSH_AUDIENCE=https://www.unomesa.com/api/billing/google-play
GOOGLE_PLAY_PUSH_SERVICE_ACCOUNT=
# Solo autoriza compras sandbox que modifican el plan del restaurante indicado.
# No se necesita para ver los planes. Nunca incluir restaurantes de uso real.
STORE_TEST_RESTAURANT_IDS=
# Conservar BILLING_PROVIDER=lemon_squeezy y CRON_SECRET existentes.

# SQL 56: variante NUEVA de Advanced mensual, volume tiers 1=$55, 2+= $45/unidad
LEMON_SQUEEZY_VARIANT_BRANCHES_MONTHLY=
# CRON_SECRET existente: protege también /api/branches/worker (cada minuto)
